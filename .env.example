# Project
QA_PROJECT_DIR=/Users/username/qa-assistant

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest

# Target
BASE_URL=https://gt.bet

# Project workspace (all generated files are stored under this folder)
# Defaults resolve to: <repo>/projects/<brand-slug>/
QA_PROJECT_ROOT=
QA_PROJECT_SLUG=
QA_ARTIFACTS_DIR=
QA_TEST_RESULTS_DIR=
QA_AUTOTEST_REPORT_DIR=
QA_ANALYZE_DIR=

# Playwright session/state
PW_STORAGE_STATE=storageState.json
PW_USE_CHROME_CHANNEL=1
PW_AUTO_SAVE_STATE=1
PW_SAVE_STATE_TIMEOUT=90
PW_PRECHECK_SOFT=0
PW_HEADED=0
PW_INCLUDE_DESTRUCTIVE=0
PW_USE_AI_GENERATION=1
PW_AI_REQUIRED=0
PW_CF_PREFER_WEBKIT=1
# Playwright projects: desktop | mobile | desktop,mobile | all
PW_PROJECT_MATRIX=desktop
PW_PRECHECK_PROJECT_MATRIX=desktop
PW_REPORT_ALLURE=0
PW_A11Y=0
PW_WAF_DIAGNOSTIC=1
# Enable when you want to continue run after precheck in heavily blocked environments.
# PW_PRECHECK_SOFT=1 can be set per command as needed.

# QA Doctor / preflight
QA_PREFLIGHT_DOCTOR=1
QA_DOCTOR_STRICT=0
QA_DOCTOR_SKIP_BROWSER=0
QA_DOCTOR_LAUNCH_TIMEOUT_MS=60000
QA_DOCTOR_NAV_TIMEOUT_MS=20000
# allowed majors for local runtime
QA_NODE_LTS_MAJORS=20,22

# Cloudflare Turnstile (QA/staging test-mode)
# Use test keys in non-production env to avoid CAPTCHA blocking of E2E.
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=
CF_TURNSTILE_TEST_MODE=0

# BrowserStack
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_BUILD_NAME=qa-assistant

# ReportPortal
RP_ENDPOINT=
RP_API_KEY=
RP_TOKEN=
RP_PROJECT=
RP_LAUNCH=
RP_DESCRIPTION=
RP_MODE=DEFAULT

# Pact Broker / can-i-deploy
PACT_BROKER_BASE_URL=
PACT_BROKER_TOKEN=
PACT_BROKER_USERNAME=
PACT_BROKER_PASSWORD=
PACT_PACTS_DIR=contracts/pacts
PACT_CONSUMER_VERSION=
PACT_BRANCH=main
PACT_PACTICIPANT=qa-assistant
PACT_VERSION=
PACT_TO_ENVIRONMENT=qa

# MailSlurp (email/OTP automation)
MAILSLURP_API_KEY=

# Sentry + OpenTelemetry
SENTRY_DSN=
SENTRY_ENVIRONMENT=qa
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.2
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
QA_TELEMETRY_SERVICE=qa-assistant
QA_TELEMETRY_DISABLED=0
QA_TELEMETRY_VERBOSE=0

# Java/Allure bootstrap
# PATH=/opt/homebrew/opt/openjdk/bin:$PATH

# Casino providers suite defaults
PW_PROVIDER_MAX=0
PW_PROVIDER_TEST_TIMEOUT=240000
PW_PROVIDER_RETRY_ON_FAIL=0
PW_PROVIDER_DESKTOP_GAMES=2
PW_PROVIDER_MIN_GAMES=1
PW_PROVIDER_ENABLE_MOBILE=0
PW_PROVIDER_MOBILE_GAMES=1
PW_PROVIDER_MODE_TIMEOUT=60000
PW_PROVIDER_STRICT_MISMATCH_BLOCK=0
PW_PROVIDER_DEMO_GAMES=3
PW_PROVIDER_DEMO_MIN_GAMES=2

# Scanner defaults
HEADLESS=1
ZAP_OUT_DIR=artifacts/zap
LHCI_DOCKER_IMAGE=mcr.microsoft.com/playwright:v1.58.0-jammy
LHCI_CONFIG_FILE=.lighthouserc.js
LHCI_DOCKER_SHM_SIZE=1g
LHCI_DOCKER_PLATFORM=
LHCI_CHROME_PATH=/ms-playwright/chromium-1208/chrome-linux/chrome
LHCI_CHROME_FLAGS=--headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu --no-zygote

# Optional registration test data
# If REG_EMAIL is empty, test uses: deko+<short-tag>@stars-partners.com
# (short-tag example: c4k9x2m)
REG_EMAIL=
# Optional auto email format: plus (default) or plain
REG_EMAIL_FORMAT=plus
# Override DD/MM/YYYY part for auto email format above
REG_EMAIL_DATE=
# Optional suffix for auto email format (appended after date)
# If empty, current time HHMMSS is used for uniqueness.
REG_EMAIL_SUFFIX=
REG_PASSWORD=
REG_FIRST_NAME=autotest
REG_LAST_NAME=autotest
REG_COUNTRY=Spain
REG_CITY=autotest
REG_ADDRESS=autotest
REG_DD=01
REG_MM=01
REG_YYYY=2001
REG_PHONE=0000000000

# Optional login positive test data (for tests/critical/login-auth.spec.js)
LOGIN_EMAIL=
LOGIN_PASSWORD=

# Gmail API (Forgot Password automation for @stars-partners.com inbox)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
PW_FORGOT_PASSWORD_MAIL_TIMEOUT=240000
PW_FORGOT_PASSWORD_MAIL_POLL=5000
