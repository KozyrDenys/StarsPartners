local.file_match "qa_events" {
  path_targets = [
    {
      __path__ = "/workspace/projects/dashboard/log-index/*.ndjson",
      job      = "qa-run-index",
      app      = "qa-assistant",
    },
  ]
}

loki.source.file "qa_events" {
  targets    = local.file_match.qa_events.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
